# Discord Bot Token (アリス用)
# Discord Developer Portal (https://discord.com/developers/applications) で取得
DISCORD_TOKEN=your_alice_discord_bot_token_here

# Discord Bot Token (ケイ用)
# Discord Developer Portal で新しいBotを作成して取得
KEI_DISCORD_TOKEN=your_kei_discord_bot_token_here

# Google Gemini API Key (共通)
# Google AI Studio (https://aistudio.google.com/app/apikey) で取得
GEN_API_KEY=your_gemini_api_key_here
