# Discord Bot Token (アリス用)
# Discord Developer Portal (https://discord.com/developers/applications) で取得
DISCORD_TOKEN=your_alice_discord_bot_token_here

# Discord Bot Token (ケイ用)
# Discord Developer Portal で新しいBotを作成して取得
KEI_DISCORD_TOKEN=your_kei_discord_bot_token_here

# Discord Bot Token (ユウカ用)
# Discord Developer Portal で新しいBotを作成して取得
YUKA_DISCORD_TOKEN=your_yuka_discord_bot_token_here

# Google Gemini API Key (共通)
# Google AI Studio (https://aistudio.google.com/app/apikey) で取得
GEN_API_KEY=your_gemini_api_key_here

# Google Gemini API Key 2 (フォールバック用・任意)
# Google AI Studio (https://aistudio.google.com/app/apikey) で取得
GEN_API_KEY_2=your_secondary_gemini_api_key_here

# ===== 誕生日通知チャンネル =====
# ユーザー誕生日のお祝いを送るチャンネルID
# 未設定の場合は Botが参加しているサーバーの最初のテキストチャンネルに送信
USER_BIRTHDAY_CHANNEL_ID=your_general_channel_id_here

# ブルアカキャラ誕生日の告知チャンネルID（お遊戯会）
# デフォルト: 1051173133228462220
BLUEARCHIVE_BIRTHDAY_CHANNEL_ID=1051173133228462220
